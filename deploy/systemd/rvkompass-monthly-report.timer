# /etc/systemd/system/rvkompass-monthly-report.timer
# Am 1. jedes Monats um 07:00 Ortszeit; war der Server aus, wird die Mail nachgeholt.

[Unit]
Description=RVKompass: Monatsstatistik am 1. jedes Monats um 07:00

[Timer]
OnCalendar=*-*-01 07:00:00
Persistent=true

[Install]
WantedBy=timers.target
